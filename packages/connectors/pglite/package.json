{
  "name": "@igorjs/pure-orm-pglite",
  "version": "0.1.0",
  "description": "PGlite (Postgres WASM) connector for @igorjs/pure-orm. Runs the Postgres dialect on Node, Deno, Bun, Cloudflare Workers, and the browser.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsgo",
    "check": "tsgo --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": ">=0.2.0"
  },
  "peerDependencies": {
    "@igorjs/pure-orm": "workspace:^"
  },
  "keywords": [
    "pure-orm",
    "pure-orm-connector",
    "postgres",
    "postgresql",
    "pglite",
    "wasm",
    "edge",
    "cloudflare",
    "browser",
    "embedded"
  ],
  "author": "igorjs <oss@mail.igorjs.io>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorjs/pure-orm.git",
    "directory": "packages/connectors/pglite"
  },
  "bugs": {
    "url": "https://github.com/igorjs/pure-orm/issues"
  },
  "homepage": "https://github.com/igorjs/pure-orm/tree/main/packages/connectors/pglite"
}
