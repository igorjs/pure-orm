{
  "name": "@igorjs/pure-orm-mysql",
  "version": "0.1.0",
  "description": "MySQL / MariaDB connector for @igorjs/pure-orm using mysql2.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsgo",
    "check": "tsgo --noEmit"
  },
  "dependencies": {
    "mysql2": ">=3.22.5"
  },
  "peerDependencies": {
    "@igorjs/pure-orm": "workspace:^"
  },
  "keywords": [
    "pure-orm",
    "pure-orm-connector",
    "mysql",
    "mariadb",
    "mysql2"
  ],
  "author": "igorjs <oss@mail.igorjs.io>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorjs/pure-orm.git",
    "directory": "packages/connectors/mysql"
  },
  "bugs": {
    "url": "https://github.com/igorjs/pure-orm/issues"
  },
  "homepage": "https://github.com/igorjs/pure-orm/tree/main/packages/connectors/mysql"
}
