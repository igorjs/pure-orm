{
  "name": "@igorjs/pure-orm-pg",
  "version": "0.1.0",
  "description": "PostgreSQL connector for @igorjs/pure-orm using the node-postgres driver (pg).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsgo",
    "check": "tsgo --noEmit"
  },
  "dependencies": {
    "pg": ">=8.21.0"
  },
  "peerDependencies": {
    "@igorjs/pure-orm": "workspace:^"
  },
  "devDependencies": {
    "@types/pg": "8.20.0"
  },
  "keywords": [
    "pure-orm",
    "pure-orm-connector",
    "postgres",
    "postgresql",
    "pg",
    "node-postgres"
  ],
  "author": "igorjs <oss@mail.igorjs.io>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorjs/pure-orm.git",
    "directory": "packages/connectors/pg"
  },
  "bugs": {
    "url": "https://github.com/igorjs/pure-orm/issues"
  },
  "homepage": "https://github.com/igorjs/pure-orm/tree/main/packages/connectors/pg"
}
